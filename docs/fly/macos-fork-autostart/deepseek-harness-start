#!/bin/bash

set -Eeuo pipefail

: "${DSH_REPO_DIR:?DSH_REPO_DIR is required}"

readonly REPO_DIR="$DSH_REPO_DIR"
readonly WORK_BRANCH="${DSH_WORK_BRANCH:-fly0819}"
readonly UPSTREAM_URL="${DSH_UPSTREAM_URL:-https://github.com/deepseek-ai/deepseek-harness.git}"
readonly LOCK_DIR="${TMPDIR:-/tmp}/deepseek-harness-start-${UID}.lock"
readonly NETWORK_ATTEMPTS="${DSH_NETWORK_ATTEMPTS:-12}"
readonly NETWORK_RETRY_SECONDS="${DSH_NETWORK_RETRY_SECONDS:-10}"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*"
}

fail() {
  log "ERROR: $*"
  exit 1
}

cleanup() {
  local status=$?

  trap - EXIT
  rm -f "$LOCK_DIR/pid"
  rmdir "$LOCK_DIR" 2>/dev/null || true

  if [[ $status -ne 0 ]] && git check-ref-format --branch "$WORK_BRANCH" >/dev/null 2>&1 && [[ "$(git -C "$REPO_DIR" branch --show-current 2>/dev/null || true)" != "$WORK_BRANCH" ]] && [[ -z "$(git -C "$REPO_DIR" status --porcelain 2>/dev/null || true)" ]]; then
    git -C "$REPO_DIR" switch "$WORK_BRANCH" >/dev/null 2>&1 || true
  fi

  exit "$status"
}

acquire_lock() {
  local lock_pid=""

  if mkdir "$LOCK_DIR" 2>/dev/null; then
    printf '%s\n' "$$" >"$LOCK_DIR/pid"
    return
  fi

  if [[ -r "$LOCK_DIR/pid" ]]; then
    read -r lock_pid <"$LOCK_DIR/pid" || true
  fi
  if [[ "$lock_pid" =~ ^[0-9]+$ ]] && kill -0 "$lock_pid" 2>/dev/null; then
    fail "another sync or Web process is already running"
  fi

  rm -f "$LOCK_DIR/pid"
  rmdir "$LOCK_DIR" 2>/dev/null || fail "cannot remove stale lock $LOCK_DIR"
  mkdir "$LOCK_DIR" 2>/dev/null || fail "cannot acquire lock $LOCK_DIR"
  printf '%s\n' "$$" >"$LOCK_DIR/pid"
}

retry_network_command() {
  local description="$1"
  shift
  local attempt=1

  until "$@"; do
    if ((attempt >= NETWORK_ATTEMPTS)); then
      fail "$description failed after $NETWORK_ATTEMPTS attempts"
    fi

    log "$description failed on attempt $attempt/$NETWORK_ATTEMPTS; retrying in ${NETWORK_RETRY_SECONDS}s"
    attempt=$((attempt + 1))
    sleep "$NETWORK_RETRY_SECONDS"
  done
}

acquire_lock
trap cleanup EXIT

[[ "$NETWORK_ATTEMPTS" =~ ^[1-9][0-9]*$ ]] ||
  fail "DSH_NETWORK_ATTEMPTS must be a positive integer"
[[ "$NETWORK_RETRY_SECONDS" =~ ^[0-9]+$ ]] ||
  fail "DSH_NETWORK_RETRY_SECONDS must be a non-negative integer"

cd "$REPO_DIR"
log "starting DeepSeek Harness fork synchronization"

[[ -z "$(git status --porcelain)" ]] ||
  fail "the working tree contains uncommitted changes"
git check-ref-format --branch "$WORK_BRANCH" >/dev/null 2>&1 ||
  fail "invalid work branch: $WORK_BRANCH"
git show-ref --verify --quiet refs/heads/master ||
  fail "local branch master does not exist"
git show-ref --verify --quiet "refs/heads/$WORK_BRANCH" ||
  fail "local branch $WORK_BRANCH does not exist"

if git remote get-url upstream >/dev/null 2>&1; then
  [[ "$(git remote get-url upstream)" == "$UPSTREAM_URL" ]] ||
    fail "upstream does not point to $UPSTREAM_URL"
else
  git remote add upstream "$UPSTREAM_URL"
  log "added upstream: $UPSTREAM_URL"
fi

log "fetching origin and upstream"
retry_network_command "fetching origin" git fetch --prune origin master "$WORK_BRANCH"
retry_network_command "fetching upstream" git fetch --prune upstream master

log "fast-forwarding master from origin and upstream"
git switch master
git merge --ff-only origin/master
git merge --ff-only upstream/master

log "pushing synchronized master to the fork"
retry_network_command "pushing synchronized master to origin" git push origin master:master

log "merging origin/master into $WORK_BRANCH"
git switch "$WORK_BRANCH"
git merge --ff-only "origin/$WORK_BRANCH"
if ! git merge --no-edit origin/master; then
  git merge --abort >/dev/null 2>&1 || true
  fail "origin/master conflicts with $WORK_BRANCH; the merge was aborted"
fi

log "removing stale build output and deleted-package residue"
pnpm run clean

log "installing dependencies"
pnpm install

log "building the repository"
pnpm run build

log "starting the Web UI"
pnpm dsh web
