ell/bash-sandbox/README.md", "source_location": "line 21", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "packages_shell_bash_sandbox_readme_deny_only_executor_seam", "label": "Deny-Only Executor Seam", "file_type": "rationale", "source_file": "shell/bash-sandbox/README.md", "source_location": "line 25", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The executor reports denials as facts and never negotiates permissions; the model-facing tool owns approval and passes an approved override back through policy."}], "edges": [{"source": "packages_shell_bash_sandbox_readme_sandbox_bash_executor", "target": "packages_shell_bash_local_readme_local_bash_executor", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "shell/bash-sandbox/README.md", "source_location": "lines 3-9", "weight": 1.0}, {"source": "packages_shell_bash_sandbox_readme_exact_argv_confinement", "target": "packages_shell_bash_sandbox_readme_sandbox_bash_executor", "relation": "rationale_for", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "shell/bash-sandbox/README.md", "source_location": "line 9", "weight": 1.0}, {"source": "packages_shell_bash_sandbox_readme_sandbox_bash_executor", "target": "packages_shell_bash_sandbox_readme_file_effect_modes", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "shell/bash-sandbox/README.md", "source_location": "lines 11-15", "weight": 1.0}, {"source": "packages_shell_bash_sandbox_readme_sandbox_bash_executor", "target": "packages_shell_bash_sandbox_readme_denial_result_facts", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "shell/bash-sandbox/README.md", "source_location": "line 19", "weight": 1.0}, {"source": "packages_shell_bash_sandbox_readme_runner_failure_attribution", "target": "packages_shell_bash_sandbox_readme_sandbox_bash_execu